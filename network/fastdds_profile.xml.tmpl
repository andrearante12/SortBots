<?xml version="1.0" encoding="UTF-8"?>
<!-- FastDDS XML profile — rendered by network/render_dds_profile.py.
     Transport only: SHM disabled, UDPv4 whitelisted to specific interfaces.
     Discovery Server is configured via ROS_DISCOVERY_SERVER env var (rmw layer).
     Removing <builtin>/<discovery_config> here is intentional: FastRTPS rmw
     reads ROS_DISCOVERY_SERVER and sets up the DS client internally. Having
     both the env var AND <discoveryProtocol>CLIENT</discoveryProtocol> in XML
     causes a conflict (Phase 3 lesson: rmw ignores the XML DS list, so the
     XML-only config silently finds no server and falls back to multicast). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udpv4_only</transport_id>
      <type>UDPv4</type>
      <!-- Whitelist: only the interfaces this participant is allowed to use.
           Use IP addresses, NOT interface names — names fail as root in netns
           (Phase 3 lesson: interface name resolution breaks inside ip netns exec). -->
      <interfaceWhiteList>
        {{INTERFACES}}
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="sortbots_mesh" is_default_profile="true">
    <rtps>
      <!-- Use only our explicit UDPv4 transport — disables SHM completely.
           SHM uses /dev/shm which is shared across network namespaces and
           would silently bypass the tap, breaking the whole point of the bridge. -->
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>udpv4_only</transport_id>
      </userTransports>
    </rtps>
  </participant>

</profiles>
