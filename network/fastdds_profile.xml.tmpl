<?xml version="1.0" encoding="UTF-8"?>
<!-- FastDDS XML profile — rendered by network/render_dds_profile.py.
     Placeholders: {{INTERFACES}} (comma-sep), {{DS_HOST}}:{{DS_PORT}}.
     Forces UDPv4-only (no SHM, no multicast) so inter-robot DDS packets
     cannot bypass the tap device and the ns-3 simulated mesh. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <!-- ── Transport ── -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udpv4_only</transport_id>
      <type>UDPv4</type>
      <!-- Whitelist: only the interfaces this participant is allowed to use.
           Rendered as a space-separated or comma-separated list. -->
      <interfaceWhiteList>
        {{INTERFACES}}
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <!-- ── Participant ── -->
  <participant profile_name="sortbots_mesh" is_default_profile="true">
    <rtps>
      <!-- Use only our explicit UDPv4 transport — disables SHM completely.
           SHM uses /dev/shm which is shared across network namespaces and
           would silently bypass the tap, breaking the whole point of the bridge. -->
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>udpv4_only</transport_id>
      </userTransports>

      <!-- Discovery Server (unicast) — eliminates multicast SPDP, which
           does not propagate cleanly through tap devices. -->
      <builtin>
        <discovery_config>
          <discoveryProtocol>CLIENT</discoveryProtocol>
          <discoveryServersList>
            <RemoteServer prefix="44.53.00.5f.45.50.52.4f.53.49.4d.41">
              <metatrafficUnicastLocatorList>
                <locator>
                  <udpv4>
                    <address>{{DS_HOST}}</address>
                    <port>{{DS_PORT}}</port>
                  </udpv4>
                </locator>
              </metatrafficUnicastLocatorList>
            </RemoteServer>
          </discoveryServersList>
        </discovery_config>
      </builtin>
    </rtps>
  </participant>

</profiles>
